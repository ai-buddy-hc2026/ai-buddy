# Local development only. Docker Compose reads .env automatically.
POSTGRES_DB=ai_buddy
POSTGRES_USER=ai_buddy
POSTGRES_PASSWORD=ai_buddy_dev

# Published ports on 127.0.0.1; internal container ports stay unchanged.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Browser-facing URL, used when building the Vite frontend.
# Update this too if BACKEND_PORT changes.
VITE_API_BASE_URL=http://localhost:8080

# Optional override, e.g. for URL-encoded PostgreSQL credentials.
# DATABASE_URL=postgres://ai_buddy:ai_buddy_dev@postgres:5432/ai_buddy?sslmode=disable
