# Local development only. Docker Compose reads .env automatically.
POSTGRES_DB=ai_buddy
POSTGRES_USER=ai_buddy
POSTGRES_PASSWORD=ai_buddy_dev

# Published ports on 127.0.0.1; internal container ports stay unchanged.
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# Synthetic local development key only. Replace for any shared deployment.
JWT_SIGNING_KEY=local-dev-synthetic-signing-key-change-before-deploy
JWT_TTL=1h

# Browser-facing URL, used when building the Vite frontend.
# Update this too if BACKEND_PORT changes.
VITE_API_BASE_URL=http://localhost:8080
# Ollama (local Docker Compose service)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3:8b
LLM_API_KEY=ollama
AI_SERVICE_TOKEN=go_and_python
MCP_SERVER_URL=http://backend:8080/mcp
AI_SERVICE_URL=http://ai-service:8000
# Отдельный синтетический токен внутреннего MCP, не пользовательский JWT.
MCP_SERVICE_TOKEN=local-dev-mcp-synthetic-token-change-before-deploy
ABSENCES_FAIL_RATE=0
# OpenAI alternative: replace the Ollama values above.
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
REDIS_HOST=redis
# Optional override, e.g. for URL-encoded PostgreSQL credentials.
# DATABASE_URL=postgres://ai_buddy:ai_buddy_dev@postgres:5432/ai_buddy?sslmode=disable
