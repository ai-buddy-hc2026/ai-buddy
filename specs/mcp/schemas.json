{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "UUID": {
      "type": "string",
      "format": "uuid",
      "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "Stage": {
      "type": "string",
      "enum": [
        "week_1",
        "week_2",
        "weeks_3_4"
      ]
    },
    "TaskStatus": {
      "type": "string",
      "enum": [
        "todo",
        "in_progress",
        "blocked",
        "done"
      ]
    },
    "AbsenceStatus": {
      "type": "string",
      "enum": [
        "pending_approval",
        "approved",
        "rejected",
        "cancelled"
      ]
    },
    "EmptyInput": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "POLICY_DENIED",
        "NOT_FOUND",
        "CONFIRMATION_REQUIRED",
        "CONFLICT",
        "VERSION_CONFLICT",
        "IDEMPOTENCY_CONFLICT",
        "DEPENDENCY_UNAVAILABLE",
        "TIMEOUT",
        "INTERNAL_ERROR"
      ]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "Failure": {
      "type": "object",
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "$ref": "#/$defs/Error"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "additionalProperties": false
    },
    "GetPlanInput": {
      "type": "object",
      "properties": {
        "intern_id": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "due_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee_id": {
          "$ref": "#/$defs/UUID"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "stage",
        "position",
        "title",
        "description",
        "status",
        "due_date",
        "assignee_id",
        "version"
      ],
      "additionalProperties": false
    },
    "NextStep": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/UUID"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "due_date": {
          "anyOf": [
            {
              "$ref": "#/$defs/Date"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "task_id",
        "title",
        "due_date"
      ],
      "additionalProperties": false
    },
    "GetPlanData": {
      "type": "object",
      "properties": {
        "employee_id": {
          "$ref": "#/$defs/UUID"
        },
        "team_id": {
          "$ref": "#/$defs/UUID"
        },
        "stage": {
          "$ref": "#/$defs/Stage"
        },
        "progress": {
          "type": "object",
          "properties": {
            "done": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "done",
            "total"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "next_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/NextStep"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "employee_id",
        "team_id",
        "stage",
        "progress",
        "tasks",
        "next_step"
      ],
      "additionalProperties": false
    },
    "UpdateStatusInput": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/UUID"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "task_id",
        "status",
        "version"
      ],
      "additionalProperties": false
    },
    "UpdateStatusData": {
      "type": "object",
      "properties": {
        "task_id": {
          "$ref": "#/$defs/UUID"
        },
        "old_status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "updated_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "task_id",
        "old_status",
        "status",
        "version",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Manager": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/UUID"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "buddy",
            "lead"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "role"
      ],
      "additionalProperties": false
    },
    "GetManagerData": {
      "type": "object",
      "properties": {
        "manager": {
          "anyOf": [
            {
              "$ref": "#/$defs/Manager"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "manager"
      ],
      "additionalProperties": false
    },
    "AbsenceType": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "label"
      ],
      "additionalProperties": false
    },
    "GetPolicyData": {
      "type": "object",
      "properties": {
        "notice_period_days": {
          "type": "integer",
          "minimum": 0
        },
        "requires_approval": {
          "const": true
        },
        "allowed_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/AbsenceType"
          }
        }
      },
      "required": [
        "notice_period_days",
        "requires_approval",
        "allowed_types"
      ],
      "additionalProperties": false
    },
    "CreateAbsenceInput": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/Date"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "date",
        "type"
      ],
      "additionalProperties": false
    },
    "CreateAbsenceData": {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/UUID"
        },
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "pending_approval"
        },
        "approver": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
        "action_id",
        "external_id",
        "status",
        "approver"
      ],
      "additionalProperties": false
    },
    "ListAbsencesInput": {
      "type": "object",
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Absence": {
      "type": "object",
      "properties": {
        "external_id": {
          "type": "string",
          "minLength": 1
        },
        "employee_id": {
          "$ref": "#/$defs/UUID"
        },
        "date": {
          "$ref": "#/$defs/Date"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "status": {
          "$ref": "#/$defs/AbsenceStatus"
        },
        "approver": {
          "$ref": "#/$defs/UUID"
        }
      },
      "required": [
        "external_id",
        "employee_id",
        "date",
        "type",
        "status",
        "approver"
      ],
      "additionalProperties": false
    },
    "ListAbsencesData": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Absence"
          }
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "GetPlanSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/GetPlanData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "GetPlanOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/GetPlanSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "GetManagerSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/GetManagerData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "GetManagerOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/GetManagerSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "GetPolicySuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/GetPolicyData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "GetPolicyOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/GetPolicySuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "ListAbsencesSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/ListAbsencesData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "ListAbsencesOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/ListAbsencesSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "Code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "ListSlotsInput": {
      "type": "object",
      "properties": {
        "employee_code": {
          "$ref": "#/$defs/Code"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SlotHost": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "name",
        "title"
      ],
      "additionalProperties": false
    },
    "Slot": {
      "type": "object",
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/UUID"
        },
        "starts_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "slot_id",
        "starts_at",
        "minutes"
      ],
      "additionalProperties": false
    },
    "ListSlotsData": {
      "type": "object",
      "properties": {
        "host": {
          "$ref": "#/$defs/SlotHost"
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Slot"
          }
        }
      },
      "required": [
        "host",
        "slots"
      ],
      "additionalProperties": false
    },
    "BookSlotInput": {
      "type": "object",
      "properties": {
        "slot_id": {
          "$ref": "#/$defs/UUID"
        },
        "topic": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "slot_id"
      ],
      "additionalProperties": false
    },
    "BookSlotData": {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/UUID"
        },
        "booking_id": {
          "type": "string",
          "minLength": 1
        },
        "slot_id": {
          "$ref": "#/$defs/UUID"
        },
        "host_code": {
          "$ref": "#/$defs/Code"
        },
        "starts_at": {
          "$ref": "#/$defs/Timestamp"
        }
      },
      "required": [
        "action_id",
        "booking_id",
        "slot_id",
        "host_code",
        "starts_at"
      ],
      "additionalProperties": false
    },
    "FindOwnerInput": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "topic"
      ],
      "additionalProperties": false
    },
    "Owner": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "ask_about": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "name",
        "title",
        "ask_about"
      ],
      "additionalProperties": false
    },
    "FindOwnerData": {
      "type": "object",
      "properties": {
        "owner": {
          "anyOf": [
            {
              "$ref": "#/$defs/Owner"
            },
            {
              "type": "null"
            }
          ]
        },
        "matched_tag": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fallback": {
          "type": "boolean"
        }
      },
      "required": [
        "owner",
        "matched_tag",
        "fallback"
      ],
      "additionalProperties": false
    },
    "RequestAccessInput": {
      "type": "object",
      "properties": {
        "system": {
          "$ref": "#/$defs/Code"
        }
      },
      "required": [
        "system"
      ],
      "additionalProperties": false
    },
    "AccessStatus": {
      "type": "string",
      "enum": [
        "pending",
        "granted"
      ]
    },
    "RequestAccessData": {
      "type": "object",
      "properties": {
        "action_id": {
          "$ref": "#/$defs/UUID"
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "$ref": "#/$defs/Code"
        },
        "status": {
          "$ref": "#/$defs/AccessStatus"
        },
        "ready_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "action_id",
        "request_id",
        "system",
        "status",
        "ready_at"
      ],
      "additionalProperties": false
    },
    "FindPlaceInput": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    },
    "Place": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Code"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "desk",
            "kitchen",
            "room",
            "lift",
            "medical"
          ]
        },
        "floor": {
          "type": "integer"
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "employee_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/Code"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "floor",
        "node_id",
        "employee_code"
      ],
      "additionalProperties": false
    },
    "FindPlaceData": {
      "type": "object",
      "properties": {
        "match": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "similar": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/Place"
          }
        }
      },
      "required": [
        "match",
        "similar"
      ],
      "additionalProperties": false
    },
    "ListSlotsSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/ListSlotsData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "ListSlotsOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/ListSlotsSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "FindOwnerSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/FindOwnerData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "FindOwnerOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/FindOwnerSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    },
    "FindPlaceSuccess": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "data": {
          "$ref": "#/$defs/FindPlaceData"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "additionalProperties": false
    },
    "FindPlaceOutput": {
      "oneOf": [
        {
          "$ref": "#/$defs/FindPlaceSuccess"
        },
        {
          "$ref": "#/$defs/Failure"
        }
      ],
      "type": "object"
    }
  }
}
