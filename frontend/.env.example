# Скопируй в frontend/.env.local (файл в .gitignore) и поправь под себя.
#
# Режим работы фронта - одно правило:
#   VITE_API_BASE_URL задан и не пустой - реальный Go API по этому адресу;
#   VITE_API_BASE_URL не задан или пустой - демо на моках из localStorage, бэкенд не нужен.
#
# /api идёт через прокси (vite dev/preview или nginx в Docker) на Go API без префикса,
# поэтому CORS на бэкенде не нужен. Полный адрес вида http://localhost:8080
# сработает только если бэкенд разрешит CORS.
VITE_API_BASE_URL=/api

# Куда dev-сервер Vite проксирует /api. По умолчанию http://localhost:8080
VITE_PROXY_TARGET=http://localhost:8080
